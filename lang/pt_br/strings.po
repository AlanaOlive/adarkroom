msgstr "escombros e ruínas margeiam as ruas."

#: script/events/setpieces.js
msgid "Collapsed Building"
msgstr "Prédio Desmoronado"

#: script/events/setpieces.js
msgid "an old house, collapsed and overgrown."
msgstr "uma velha casa, desmoronada e coberta por vegetação."

#: script/events/setpieces.js
msgid "dust and ash choke the air."
msgstr "poeira e cinzas enchem o ar."

#: script/events/setpieces.js
