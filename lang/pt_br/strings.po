#: script/outside.js
msgid "the sky is clear. the wind is cold."
msgstr "o céu está limpo. o vento está frio."

#: script/outside.js
msgid "a dusty world stretches out to the horizon."
msgstr "um mundo empoeirado se estende até o horizonte."

#: script/outside.js
