#: script/events/room.js
msgid "the fire is going out."
msgstr "o fogo está se apagando."

#: script/events/room.js
msgid "the wood has run out."
msgstr "a madeira acabou."

#: script/events/room.js
msgid "a Noisy Beggar"
msgstr "Um Mendigo Barulhento"

#: script/events/room.js
msgid "a beggar arrives, asking for wood and food."
msgstr "um mendigo chega, pedindo madeira e comida."

#: script/events/room.js
msgid "brush him away"
msgstr "dispensá-lo"

#: script/events/room.js
msgid "share resources"
msgstr "compartilhar recursos"

#: script/events/room.js
msgid "the beggar leaves, cursing your name."
msgstr "o mendigo parte, amaldiçoando seu nome."

#: script/events/room.js
msgid "the beggar leaves, with a grunt of thanks."
msgstr "o mendigo parte, resmungando um agradecimento."

#: script/events/room.js
msgid "a Sick Man"
msgstr "Um Homem Doente"

#: script/events/room.js
msgid "a sick man asks for meds, can't survive the cold."
msgstr "um homem doente pede remédios, incapaz de sobreviver ao frio."

#: script/events/room.js
msgid "turn him away"
msgstr "mandá-lo embora"

#: script/events/room.js
msgid "give 10 meds"
msgstr "dar 10 remédios"

#: script/events/room.js
msgid "give 50 meds"
msgstr "dar 50 remédios"

#: script/events/room.js
msgid "the man leaves without medicines, and you hear him cough outside."
msgstr "o homem parte sem remédios e você o ouve tossir lá fora."

#: script/events/room.js
msgid "the man takes the medicines eagerly, and leaves."
msgstr "o homem pega os remédios ansiosamente e parte."

#: script/events/room.js
msgid "a Mysterious Wanderer"
msgstr "Um Andarilho Misterioso"

#: script/events/room.js
msgid "a wanderer arrives from the forest, looking bedraggled."
msgstr "um andarilho chega da floresta com aparência maltrapilha."

#: script/events/room.js
msgid "the wanderer leaves, not saying a word."
msgstr "o andarilho parte sem dizer uma palavra."

