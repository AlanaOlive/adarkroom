# CORREÇÃO: era "#, fuzzy" — flag removida para que a tradução seja exibida
#: script/events/outside.js
msgid "there was a beast. it's dead now"
msgstr "havia uma fera. ela está morta agora"

#: script/events/outside.js
msgid "a terrible plague is fast spreading through the village."
msgstr "uma terrível praga se espalha rapidamente pela aldeia."

#: script/events/outside.js
msgid "a plague afflicts the village"
msgstr "uma praga aflige a aldeia"

#: script/events/outside.js
msgid "the plague is kept from spreading."
msgstr "a praga é contida e não se espalha."

#: script/events/outside.js
msgid "only a few die."
msgstr "apenas alguns morrem."

#: script/events/outside.js
msgid "the rest bury them."
msgstr "o restante os enterra."

#: script/events/outside.js
msgid "epidemic is eradicated eventually"
msgstr "a epidemia é finalmente erradicada"

#: script/events/outside.js
msgid "the plague rips through the village."
msgstr "a praga devasta a aldeia."

#: script/events/outside.js
msgid "the only hope is a quick death."
msgstr "a única esperança é uma morte rápida."

#: script/events/outside.js
msgid "population is almost exterminated"
msgstr "a população está quase dizimada"

#: script/events/outside.js
msgid "A Beast Attack"
msgstr "Um Ataque de Feras"

#: script/events/outside.js
msgid "a pack of snarling beasts pours out of the trees."
msgstr "um bando de feras furiosas emerge das árvores."

#: script/events/outside.js
msgid "the fight is short and bloody, but the beasts are repelled."
msgstr "a luta é curta e sangrenta, mas as feras são repelidas."

#: script/events/outside.js
msgid "the villagers retreat to mourn the dead."
msgstr "os aldeões se retiram para chorar pelos mortos."

#: script/events/outside.js
msgid "wild beasts attack the villagers"
msgstr "feras selvagens atacam os aldeões"

#: script/events/outside.js
msgid "predators become prey. price is unfair"
msgstr "predadores se tornam presas. o preço é injusto"

