msgstr "remover escombros"

#: script/events/setpieces.js
msgid "A Destroyed Town"
msgstr "Uma Cidade Destruída"

#: script/events/setpieces.js
msgid "once a small town. now a shattered husk."
msgstr "um dia foi uma pequena cidade. agora é uma carcaça destroçada."

#: script/events/setpieces.js
msgid "the roads are overgrown, shops and houses crumbled."
msgstr "as estradas estão tomadas pela vegetação; lojas e casas desmoronadas."

#: script/events/setpieces.js
msgid "An Old Battlefield"
msgstr "Um Antigo Campo de Batalha"

#: script/events/setpieces.js
msgid "an old battlefield, the land littered with the dead."
msgstr "um antigo campo de batalha, o terreno repleto de mortos."

#: script/events/setpieces.js
msgid "nothing living dares this place."
msgstr "nada vivo ousa se aproximar deste lugar."

