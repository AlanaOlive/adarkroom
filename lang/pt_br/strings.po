#: script/perks.js
msgid "body is thrifty, making the most of the few supplies available."
msgstr "o corpo é econômico, aproveitando ao máximo os poucos recursos disponíveis."

#: script/perks.js
msgid "desert rat"
msgstr "rato do deserto"

#: script/perks.js
